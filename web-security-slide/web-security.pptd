title: 网络设备的Web服务安全研究
size: [1280, 720]
theme:
  colors:
    primary: "#1E293B"
    secondary: "#64748B"
    accent: "#A6192E"
    background: "#F8FAFC"
    text: "#0F172A"
    panel: "#FFFFFF"
    soft: "#F1F5F9"
    rule: "#E2E8F0"
    risk: "#DC2626"
    success: "#059669"
    navActive: "#A6192E"
    navBg: "#1E293B"
    navText: "#FFFFFF"
  textStyles:
    coverTitle:
      fontSize: 40
      color: "#FFFFFF"
      fontFamily: "QuattrocentoSans, MiSans"
      lineHeight: 1.2
    coverSubtitle:
      fontSize: 22
      color: "#CBD5E1"
      fontFamily: "QuattrocentoSans, MiSans"
      lineHeight: 1.4
    chapterTitle:
      fontSize: 36
      color: "#FFFFFF"
      fontFamily: "QuattrocentoSans, MiSans"
      lineHeight: 1.2
    chapterSubtitle:
      fontSize: 20
      color: "#CBD5E1"
      fontFamily: "QuattrocentoSans, MiSans"
      lineHeight: 1.4
    chapterNum:
      fontSize: 120
      color: "#FFFFFF20"
      fontFamily: "QuattrocentoSans, MiSans"
      lineHeight: 1.0
    title:
      fontSize: 28
      color: "$primary"
      fontFamily: "QuattrocentoSans, MiSans"
      lineHeight: 1.3
    subtitle:
      fontSize: 22
      color: "$secondary"
      fontFamily: "QuattrocentoSans, MiSans"
      lineHeight: 1.3
    body:
      fontSize: 18
      color: "$text"
      fontFamily: "QuattrocentoSans, MiSans"
      lineHeight: 1.6
    caption:
      fontSize: 14
      color: "$secondary"
      fontFamily: "QuattrocentoSans, MiSans"
      lineHeight: 1.4
    nav:
      fontSize: 12
      color: "#FFFFFF"
      fontFamily: "QuattrocentoSans, MiSans"
      lineHeight: 1.2
    kpi:
      fontSize: 32
      color: "$accent"
      fontFamily: "QuattrocentoSans, MiSans"
      lineHeight: 1.2
    badge:
      fontSize: 12
      color: "#FFFFFF"
      fontFamily: "QuattrocentoSans, MiSans"
      lineHeight: 1.2
    quote:
      fontSize: 16
      color: "$secondary"
      fontFamily: "QuattrocentoSans, MiSans"
      lineHeight: 1.5
      fontStyle: italic
  tableStyles:
    default:
      fontSize: 16
      fontFamily: "QuattrocentoSans, MiSans"
      headerFill: "$primary"
      headerColor: "#FFFFFF"
      headerBold: true
      bodyFill: ["#FFFFFF", "$soft"]
      bodyColor: "$text"
      border:
        style: solid
        width: 1
        color: "$rule"
      headerBorder:
        style: solid
        width: 2
        color: "$primary"
      bodyBorder:
        style: none
        color: "#00000000"
      lastRowBorder:
        style: solid
        width: 2
        color: "$primary"
pages:
  - pages/cover.page
  - pages/toc.page
  - pages/background.page
  - pages/ch01_title.page
  - pages/satc_detail_1.page
  - pages/satc_detail_2.page
  - pages/hermescan_detail_1.page
  - pages/hermescan_detail_2.page
  - pages/lara_detail_1.page
  - pages/lara_detail_2.page
  - pages/ch01_summary.page
  - pages/ch02_title.page
  - pages/karonte_detail_1.page
  - pages/karonte_detail_2.page
  - pages/mangodfa_detail_1.page
  - pages/mangodfa_detail_2.page
  - pages/octopustaint_detail_1.page
  - pages/octopustaint_detail_2.page
  - pages/ch02_summary.page
  - pages/ch03_title.page
  - pages/iotscope_detail_1.page
  - pages/iotscope_detail_2.page
  - pages/eagleeye_detail_1.page
  - pages/eagleeye_detail_2.page
  - pages/pangolin_detail_1.page
  - pages/pangolin_detail_2.page
  - pages/ch03_summary.page
  - pages/ch04_title.page
  - pages/nuwa_detail_1.page
  - pages/nuwa_detail_2.page
  - pages/labrador_detail_1.page
  - pages/labrador_detail_2.page
  - pages/firmagent_detail_1.page
  - pages/firmagent_detail_2.page
  - pages/ch04_summary.page
  - pages/defense.page
  - pages/final.page
