pageType: content
background:
  type: solid
  color: "$background"
elements:
  # ===== NAV BAR =====
  - elementId: nav-bg
    elementType: shape
    bounds: [0, 0, 1280, 40]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"

  - elementId: nav-active
    elementType: shape
    bounds: [320, 0, 320, 40]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  - elementId: nav-t1
    elementType: text
    bounds: [0, 0, 320, 40]
    content:
      style: "$nav"
      align: [center, middle]
      wrap: false
      text: |
        <p>维度一: Source</p>

  - elementId: nav-t2
    elementType: text
    bounds: [320, 0, 320, 40]
    content:
      style: "$nav"
      align: [center, middle]
      wrap: false
      text: |
        <p>维度二: Propagation</p>

  - elementId: nav-t3
    elementType: text
    bounds: [640, 0, 320, 40]
    content:
      style: "$nav"
      align: [center, middle]
      wrap: false
      text: |
        <p>维度三: Sink</p>

  - elementId: nav-t4
    elementType: text
    bounds: [960, 0, 320, 40]
    content:
      style: "$nav"
      align: [center, middle]
      wrap: false
      text: |
        <p>维度四: Verification</p>

  - elementId: nav-line
    elementType: shape
    bounds: [0, 40, 1280, 2]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  # ===== TITLE & BADGE =====
  - elementId: page-title
    elementType: text
    bounds: [60, 54, 900, 40]
    content:
      style: "$title"
      align: [left, middle]
      wrap: false
      text: |
        <p>OctopusTaint — RDA+AIL的污点回溯与净化检查</p>

  - elementId: badge-bg
    elementType: shape
    bounds: [1060, 58, 140, 28]
    shapeName: roundRect
    adjustments: [8000]
    fill:
      type: solid
      color: "$accent"

  - elementId: badge-text
    elementType: text
    bounds: [1060, 58, 140, 28]
    content:
      style: "$badge"
      align: [center, middle]
      wrap: false
      text: |
        <p>ACM CCS 2024</p>

  # ===== LEFT COLUMN: 内容摘要 & 研究背景 =====
  - elementId: left-bar-1
    elementType: shape
    bounds: [60, 108, 4, 24]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  - elementId: left-subtitle-1
    elementType: text
    bounds: [72, 106, 348, 28]
    content:
      style: "$subtitle"
      align: [left, middle]
      wrap: false
      text: |
        <p>内容摘要</p>

  - elementId: left-body-1
    elementType: text
    bounds: [60, 142, 360, 190]
    content:
      style: "$body"
      align: [left, top]
      text: |
        <p>结合增强RDA、净化检查与跨边界传播建模的固件污点分析框架。以AIL中间表示恢复变量语义，基于数据流图从Sink反向回溯Source，加入净化语义检查、NVRAM路径拼接与新污点源发现。</p>

  - elementId: left-bar-2
    elementType: shape
    bounds: [60, 348, 4, 24]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  - elementId: left-subtitle-2
    elementType: text
    bounds: [72, 346, 348, 28]
    content:
      style: "$subtitle"
      align: [left, middle]
      wrap: false
      text: |
        <p>研究背景</p>

  - elementId: left-body-2
    elementType: text
    bounds: [60, 382, 360, 230]
    content:
      style: "$body"
      align: [left, top]
      text: |
        <p>动态符号执行性能瓶颈严重；盲目污点追踪忽略中间安全校验导致高误报；间接调用与非标准输入源在传统分析中严重遗漏，导致漏报。</p>

  # ===== MIDDLE COLUMN: 核心洞察 & 解决方案 =====
  - elementId: mid-bar-1
    elementType: shape
    bounds: [440, 108, 4, 24]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  - elementId: mid-subtitle-1
    elementType: text
    bounds: [452, 106, 348, 28]
    content:
      style: "$subtitle"
      align: [left, middle]
      wrap: false
      text: |
        <p>核心洞察</p>

  - elementId: mid-body-1
    elementType: text
    bounds: [440, 142, 360, 250]
    content:
      style: "$body"
      align: [left, top]
      text: |
        <p>弃用动态符号执行，引入AIL增强的RDA。VEX-IR提升为AIL中间语言，解决栈变量精确处理难题。自汇聚点向源点逆向回溯，仅关注与Sink相关路径。细粒度净化语义检查主动剔除安全路径。</p>

  - elementId: mid-bar-2
    elementType: shape
    bounds: [440, 400, 4, 24]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  - elementId: mid-subtitle-2
    elementType: text
    bounds: [452, 398, 348, 28]
    content:
      style: "$subtitle"
      align: [left, middle]
      wrap: false
      text: |
        <p>解决方案</p>

  - elementId: mid-body-2
    elementType: text
    bounds: [440, 434, 360, 250]
    content:
      style: "$body"
      align: [left, top]
      text: |
        <p>1. AIL与Sink-to-Source：VEX-IR提升为AIL，自底向上搜索。</p>
        <p>2. 净化检查：评估路径条件，剔除已净化安全路径。</p>
        <p>3. 跨边界追踪：NVRAM路径拼接与新污点源发现。</p>

  # ===== RIGHT COLUMN: 关键数据 =====
  - elementId: right-bar
    elementType: shape
    bounds: [820, 108, 4, 24]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  - elementId: right-subtitle
    elementType: text
    bounds: [832, 106, 348, 28]
    content:
      style: "$subtitle"
      align: [left, middle]
      wrap: false
      text: |
        <p>关键数据</p>

  # Card 1
  - elementId: card1-bg
    elementType: shape
    bounds: [840, 150, 340, 120]
    shapeName: roundRect
    adjustments: [8000]
    fill:
      type: solid
      color: "$panel"
    border:
      style: solid
      width: 1
      color: "$rule"

  - elementId: card1-num
    elementType: text
    bounds: [860, 165, 300, 42]
    content:
      style: "$kpi"
      align: [left, middle]
      wrap: false
      text: |
        <p>49</p>

  - elementId: card1-label
    elementType: text
    bounds: [860, 215, 300, 24]
    content:
      style: "$caption"
      align: [left, middle]
      wrap: false
      text: |
        <p>0-day 漏洞验证</p>

  # Card 2
  - elementId: card2-bg
    elementType: shape
    bounds: [840, 290, 340, 120]
    shapeName: roundRect
    adjustments: [8000]
    fill:
      type: solid
      color: "$panel"
    border:
      style: solid
      width: 1
      color: "$rule"

  - elementId: card2-num
    elementType: text
    bounds: [860, 305, 300, 42]
    content:
      style: "$kpi"
      align: [left, middle]
      wrap: false
      text: |
        <p>1,542</p>

  - elementId: card2-label
    elementType: text
    bounds: [860, 355, 300, 24]
    content:
      style: "$caption"
      align: [left, middle]
      wrap: false
      text: |
        <p>固件大规模数据集</p>

  # Card 3
  - elementId: card3-bg
    elementType: shape
    bounds: [840, 430, 340, 120]
    shapeName: roundRect
    adjustments: [8000]
    fill:
      type: solid
      color: "$panel"
    border:
      style: solid
      width: 1
      color: "$rule"

  - elementId: card3-num
    elementType: text
    bounds: [860, 445, 300, 42]
    content:
      style: "$kpi"
      align: [left, middle]
      wrap: false
      text: |
        <p>83%</p>

  - elementId: card3-label
    elementType: text
    bounds: [860, 495, 300, 24]
    content:
      style: "$caption"
      align: [left, middle]
      wrap: false
      text: |
        <p>复杂间接调用场景召回率</p>

  # ===== FOOTER =====
  - elementId: footer-left
    elementType: text
    bounds: [60, 690, 400, 20]
    content:
      style: "$caption"
      align: [left, middle]
      wrap: false
      text: |
        <p>网络设备Web服务安全研究</p>

  - elementId: footer-right
    elementType: text
    bounds: [1100, 690, 120, 20]
    content:
      style: "$caption"
      align: [right, middle]
      wrap: false
      text: |
        <p>17 / 37</p>
