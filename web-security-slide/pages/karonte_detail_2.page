pageType: content
background:
  type: solid
  color: "$background"
elements:
  # ===== NAV BAR =====
  - elementId: nav-bg
    elementType: shape
    bounds: [0, 0, 1280, 40]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"

  - elementId: nav-active
    elementType: shape
    bounds: [320, 0, 320, 40]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  - elementId: nav-t1
    elementType: text
    bounds: [0, 0, 320, 40]
    content:
      style: "$nav"
      align: [center, middle]
      wrap: false
      text: |
        <p>维度一: Source</p>

  - elementId: nav-t2
    elementType: text
    bounds: [320, 0, 320, 40]
    content:
      style: "$nav"
      align: [center, middle]
      wrap: false
      text: |
        <p>维度二: Propagation</p>

  - elementId: nav-t3
    elementType: text
    bounds: [640, 0, 320, 40]
    content:
      style: "$nav"
      align: [center, middle]
      wrap: false
      text: |
        <p>维度三: Sink</p>

  - elementId: nav-t4
    elementType: text
    bounds: [960, 0, 320, 40]
    content:
      style: "$nav"
      align: [center, middle]
      wrap: false
      text: |
        <p>维度四: Verification</p>

  - elementId: nav-line
    elementType: shape
    bounds: [0, 40, 1280, 2]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  # ===== TITLE & BADGE =====
  - elementId: page-title
    elementType: text
    bounds: [60, 54, 880, 40]
    content:
      style: "$title"
      align: [left, middle]
      wrap: false
      text: |
        <p>KARONTE — 实验结果与文章评价</p>

  - elementId: badge-bg
    elementType: shape
    bounds: [1080, 58, 140, 28]
    shapeName: roundRect
    adjustments: [8000]
    fill:
      type: solid
      color: "$accent"

  - elementId: badge-text
    elementType: text
    bounds: [1080, 58, 140, 28]
    content:
      style: "$badge"
      align: [center, middle]
      wrap: false
      text: |
        <p>IEEE S&P 2020</p>

  # ===== EXPERIMENTAL RESULTS =====
  - elementId: results-bar
    elementType: shape
    bounds: [60, 108, 4, 24]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  - elementId: results-subtitle
    elementType: text
    bounds: [72, 106, 348, 28]
    content:
      style: "$subtitle"
      align: [left, middle]
      wrap: false
      text: |
        <p>实验结果</p>

  - elementId: results-table
    elementType: table
    bounds: [60, 148, 600, 200]
    columnWidths: [0.5, 0.5]
    rowHeights: [0.16, 0.21, 0.21, 0.21, 0.21]
    style: "$default"
    rows:
      - - content: {text: "评估指标"}
        - content: {text: "数值"}
      - - content: {text: "固件样本"}
        - content: {text: "53 个"}
      - - content: {text: "0-day 漏洞"}
        - content: {text: "46 个"}
      - - content: {text: "平均告警数（传统）"}
        - content: {text: "722 个"}
      - - content: {text: "平均告警数（KARONTE）"}
        - content: {text: "2 个"}

  - elementId: results-note
    elementType: text
    bounds: [700, 148, 520, 200]
    content:
      style: "$body"
      align: [left, top]
      text: |
        <p><strong>与现有方法对比</strong></p>
        <p>传统单二进制静态分析不考虑跨组件交互，导致误报极高。KARONTE将平均告警从722个降至2个，警报总数降低两个数量级（20,931 → 74），解决了静态分析的误报瓶颈。</p>

  # ===== ARTICLE EVALUATION =====
  - elementId: eval-bar
    elementType: shape
    bounds: [60, 370, 4, 24]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  - elementId: eval-subtitle
    elementType: text
    bounds: [72, 368, 348, 28]
    content:
      style: "$subtitle"
      align: [left, middle]
      wrap: false
      text: |
        <p>文章评价</p>

  # Evaluation: 优势
  - elementId: eval1-bar
    elementType: shape
    bounds: [60, 412, 4, 24]
    shapeName: rect
    fill:
      type: solid
      color: "$success"

  - elementId: eval1-subtitle
    elementType: text
    bounds: [72, 410, 348, 28]
    content:
      fontSize: 18
      color: "$success"
      fontFamily: "QuattrocentoSans, MiSans"
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>优势</strong></p>

  - elementId: eval1-body
    elementType: text
    bounds: [60, 446, 360, 220]
    content:
      style: "$body"
      align: [left, top]
      text: |
        <p>奠定了多二进制IPC数据流抽象的基础，是后续跨组件固件分析的重要基础设计。通过BDG建模将跨进程通信形式化，首次系统解决了多二进制固件中的数据流追踪问题。</p>

  # Evaluation: 局限
  - elementId: eval2-bar
    elementType: shape
    bounds: [440, 412, 4, 24]
    shapeName: rect
    fill:
      type: solid
      color: "$risk"

  - elementId: eval2-subtitle
    elementType: text
    bounds: [452, 410, 348, 28]
    content:
      fontSize: 18
      color: "$risk"
      fontFamily: "QuattrocentoSans, MiSans"
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>局限</strong></p>

  - elementId: eval2-body
    elementType: text
    bounds: [440, 446, 360, 220]
    content:
      style: "$body"
      align: [left, top]
      text: |
        <p>① 符号执行开销重，难以支撑大规模固件扫描；② 边界二进制过滤策略会遗漏内部组件漏洞；③ 通信范式覆盖不全时，BDG会出现断裂，导致跨组件路径丢失。</p>

  # Evaluation: 商业化
  - elementId: eval3-bar
    elementType: shape
    bounds: [820, 412, 4, 24]
    shapeName: rect
    fill:
      type: solid
      color: "$secondary"

  - elementId: eval3-subtitle
    elementType: text
    bounds: [832, 410, 348, 28]
    content:
      fontSize: 18
      color: "$secondary"
      fontFamily: "QuattrocentoSans, MiSans"
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>商业化</strong></p>

  - elementId: eval3-body
    elementType: text
    bounds: [820, 446, 360, 220]
    content:
      style: "$body"
      align: [left, top]
      text: |
        <p>依赖建模完备性与符号执行开销，仅适合高价值样本的离线分析，不适合作为批量商用扫描主引擎。</p>

  # ===== FOOTER =====
  - elementId: footer-left
    elementType: text
    bounds: [60, 690, 400, 20]
    content:
      style: "$caption"
      align: [left, middle]
      wrap: false
      text: |
        <p>网络设备Web服务安全研究</p>

  - elementId: footer-right
    elementType: text
    bounds: [1100, 690, 120, 20]
    content:
      style: "$caption"
      align: [right, middle]
      wrap: false
      text: |
        <p>14 / 37</p>
