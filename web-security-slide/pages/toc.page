pageType: table_of_contents
background:
  type: solid
  color: "$background"
elements:
  - elementId: top-sep
    elementType: shape
    shapeName: rect
    bounds: [0, 40, 1280, 2]
    fill:
      type: solid
      color: "$primary"

  - elementId: toc-title
    elementType: text
    bounds: [60, 50, 200, 40]
    content:
      style: "$title"
      wrap: false
      align: [left, middle]
      text: |
        <p>目录</p>

  - elementId: card-bg-1
    elementType: shape
    shapeName: roundRect
    adjustments: [2000]
    bounds: [84, 130, 260, 420]
    fill:
      type: solid
      color: "$panel"
    border:
      style: solid
      width: 1
      color: "$rule"

  - elementId: card-bg-2
    elementType: shape
    shapeName: roundRect
    adjustments: [2000]
    bounds: [368, 130, 260, 420]
    fill:
      type: solid
      color: "$panel"
    border:
      style: solid
      width: 1
      color: "$rule"

  - elementId: card-bg-3
