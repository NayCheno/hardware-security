pageType: content
background:
  type: solid
  color: "$background"
elements:
  # ===== NAV BAR =====
  - elementId: nav-bg
    elementType: shape
    bounds: [0, 0, 1280, 40]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"

  - elementId: nav-active
    elementType: shape
    bounds: [960, 0, 320, 40]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  - elementId: nav-t1
    elementType: text
    bounds: [0, 0, 320, 40]
    content:
      style: "$nav"
      align: [center, middle]
      wrap: false
      text: |
        <p>维度一: Source</p>

  - elementId: nav-t2
    elementType: text
    bounds: [320, 0, 320, 40]
    content:
      style: "$nav"
      align: [center, middle]
      wrap: false
      text: |
        <p>维度二: Propagation</p>

  - elementId: nav-t3
    elementType: text
    bounds: [640, 0, 320, 40]
    content:
      style: "$nav"
      align: [center, middle]
      wrap: false
      text: |
        <p>维度三: Sink</p>

  - elementId: nav-t4
    elementType: text
    bounds: [960, 0, 320, 40]
    content:
      style: "$nav"
      align: [center, middle]
      wrap: false
      text: |
        <p>维度四: Verification</p>

  - elementId: nav-line
    elementType: shape
    bounds: [0, 40, 1280, 2]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  # ===== TITLE & BADGE =====
  - elementId: page-title
    elementType: text
    bounds: [60, 54, 880, 40]
    content:
      style: "$title"
      align: [left, middle]
      wrap: false
      text: |
        <p>NÜWA — 实验结果与文章评价</p>

  - elementId: badge-bg
    elementType: shape
    bounds: [1050, 58, 170, 28]
    shapeName: roundRect
    adjustments: [8000]
    fill:
      type: solid
      color: "$accent"

  - elementId: badge-text
    elementType: text
    bounds: [1050, 58, 170, 28]
    content:
      style: "$badge"
      align: [center, middle]
      wrap: false
      text: |
        <p>USENIX Security 2025</p>

  # ===== EXPERIMENTAL RESULTS =====
  - elementId: results-bar
    elementType: shape
    bounds: [60, 108, 4, 24]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  - elementId: results-subtitle
    elementType: text
    bounds: [72, 106, 348, 28]
    content:
      style: "$subtitle"
      align: [left, middle]
      wrap: false
      text: |
        <p>实验结果</p>

  - elementId: results-table
    elementType: table
    bounds: [60, 148, 600, 240]
    columnWidths: [0.5, 0.5]
    rowHeights: [0.15, 0.17, 0.17, 0.17, 0.17, 0.17]
    style: "$default"
    rows:
      - - content: {text: "评估指标"}
        - content: {text: "数值"}
      - - content: {text: "已知漏洞基准"}
        - content: {text: "31个 (13厂商)"}
      - - content: {text: "确认真实告警"}
        - content: {text: "51个"}
      - - content: {text: "覆盖已知漏洞"}
        - content: {text: "28个 + 12关联"}
      - - content: {text: "检测准确率"}
        - content: {text: "76%"}
      - - content: {text: "约束提取准确率"}
        - content: {text: "95% / 86% / 85%"}

  - elementId: results-note
    elementType: text
    bounds: [700, 148, 520, 240]
    content:
      style: "$body"
      align: [left, top]
      text: |
        <p><strong>与现有方法对比</strong></p>
        <p>相比SaTC/LARA/Mango/OctopusTaint分别多发现18/6/17/19个漏洞。约束提取准确率：前端约束95%、后端显式约束86%、后端隐式约束85%。</p>

  # ===== ARTICLE EVALUATION =====
  - elementId: eval-bar
    elementType: shape
    bounds: [60, 410, 4, 24]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  - elementId: eval-subtitle
    elementType: text
    bounds: [72, 408, 348, 28]
    content:
      style: "$subtitle"
      align: [left, middle]
      wrap: false
      text: |
        <p>文章评价</p>

  # Evaluation: 优势
  - elementId: eval1-bar
    elementType: shape
    bounds: [60, 452, 4, 24]
    shapeName: rect
    fill:
      type: solid
      color: "$success"

  - elementId: eval1-subtitle
    elementType: text
    bounds: [72, 450, 348, 28]
    content:
      fontSize: 18
      color: "$success"
      fontFamily: "QuattrocentoSans, MiSans"
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>优势</strong></p>

  - elementId: eval1-body
    elementType: text
    bounds: [60, 486, 360, 180]
    content:
      style: "$body"
      align: [left, top]
      text: |
        <p>从约束一致性角度解释漏洞成因，而非仅判断可达性。将前后端语义差异量化为检测信号，提供了不同于传统污点分析的新视角。</p>

  # Evaluation: 局限
  - elementId: eval2-bar
    elementType: shape
    bounds: [440, 452, 4, 24]
    shapeName: rect
    fill:
      type: solid
      color: "$risk"

  - elementId: eval2-subtitle
    elementType: text
    bounds: [452, 450, 348, 28]
    content:
      fontSize: 18
      color: "$risk"
      fontFamily: "QuattrocentoSans, MiSans"
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>局限</strong></p>

  - elementId: eval2-body
    elementType: text
    bounds: [440, 486, 360, 180]
    content:
      style: "$body"
      align: [left, top]
      text: |
        <p>约束提取不完整直接影响检测有效性。复杂JavaScript前端校验、动态生成约束难以静态提取。后端隐式约束（如业务逻辑）识别仍有限。</p>

  # Evaluation: 商业化
  - elementId: eval3-bar
    elementType: shape
    bounds: [820, 452, 4, 24]
    shapeName: rect
    fill:
      type: solid
      color: "$secondary"

  - elementId: eval3-subtitle
    elementType: text
    bounds: [832, 450, 348, 28]
    content:
      fontSize: 18
      color: "$secondary"
      fontFamily: "QuattrocentoSans, MiSans"
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>商业化</strong></p>

  - elementId: eval3-body
    elementType: text
    bounds: [820, 486, 360, 180]
    content:
      style: "$body"
      align: [left, top]
      text: |
        <p>适合固件发布前安全检查，将约束一致性验证集成到CI/CD流水线中，作为发布前自动漏洞筛查环节。</p>

  # ===== FOOTER =====
  - elementId: footer-left
    elementType: text
    bounds: [60, 690, 400, 20]
    content:
      style: "$caption"
      align: [left, middle]
      wrap: false
      text: |
        <p>网络设备Web服务安全研究</p>

  - elementId: footer-right
    elementType: text
    bounds: [1100, 690, 120, 20]
    content:
      style: "$caption"
      align: [right, middle]
      wrap: false
      text: |
        <p>30 / 37</p>
