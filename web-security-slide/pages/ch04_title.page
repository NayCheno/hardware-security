pageType: chapter
background:
  type: solid
  color: "$primary"
elements:
  - elementId: right-panel
    elementType: shape
    bounds: [853, 0, 427, 720]
    shapeName: rect
    fill:
      type: gradient
      gradientType: linear
      angle: 0
      stops:
        - {position: 0, color: "$primary"}
        - {position: 1, color: "#0F172A"}

  - elementId: ch-num
    elementType: text
    bounds: [60, 140, 500, 160]
    content:
      style: "$chapterNum"
      align: [left, middle]
      wrap: false
      text: |
        <p>04</p>

  - elementId: accent-line
    elementType: shape
    bounds: [60, 320, 60, 4]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  - elementId: ch-title
    elementType: text
    bounds: [60, 340, 740, 48]
    content:
      style: "$chapterTitle"
      align: [left, middle]
      wrap: false
      text: |
        <p>漏洞验证与PoC生成（Verification）</p>

  - elementId: ch-subtitle
    elementType: text
    bounds: [60, 400, 740, 32]
    content:
      style: "$chapterSubtitle"
      align: [left, middle]
      wrap: false
      text: |
        <p>从静态告警到动态闭环</p>

  - elementId: ch-intro
    elementType: text
    bounds: [60, 460, 740, 100]
    content:
      fontSize: 18
      color: "#CBD5E1"
      fontFamily: "QuattrocentoSans, MiSans"
      lineHeight: 1.6
      align: [left, top]
      text: |
        <p>核心痛点：静态污点分析产生大量告警，黑盒Fuzzing缺乏内部覆盖率指导。如何高效验证漏洞并生成PoC？</p>
        <p>技术演进：约束语义不一致性分析 → 响应反馈导向Fuzzing → 动静结合Agent自动利用</p>

  - elementId: ch-papers
    elementType: text
    bounds: [60, 600, 740, 60]
    content:
      fontSize: 14
      color: "#94A3B8"
      fontFamily: "QuattrocentoSans, MiSans"
      lineHeight: 1.6
      align: [left, top]
      text: |
        <p>NÜWA (USENIX Security 2025)  →  LABRADOR (IEEE S&P 2024)  →  FirmAgent (NDSS 2026)</p>
