pageType: content
background:
  type: solid
  color: "$background"
elements:
  # ===== NAV BAR =====
  - elementId: nav-bg
    elementType: shape
    bounds: [0, 0, 1280, 40]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"

  - elementId: nav-active
    elementType: shape
    bounds: [0, 0, 320, 40]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  - elementId: nav-t1
    elementType: text
    bounds: [0, 0, 320, 40]
    content:
      style: "$nav"
      align: [center, middle]
      wrap: false
      text: |
        <p>维度一: Source</p>

  - elementId: nav-t2
    elementType: text
    bounds: [320, 0, 320, 40]
    content:
      style: "$nav"
      align: [center, middle]
      wrap: false
      text: |
        <p>维度二: Propagation</p>

  - elementId: nav-t3
    elementType: text
    bounds: [640, 0, 320, 40]
    content:
      style: "$nav"
      align: [center, middle]
      wrap: false
      text: |
        <p>维度三: Sink</p>

  - elementId: nav-t4
    elementType: text
    bounds: [960, 0, 320, 40]
    content:
      style: "$nav"
      align: [center, middle]
      wrap: false
      text: |
        <p>维度四: Verification</p>

  - elementId: nav-line
    elementType: shape
    bounds: [0, 40, 1280, 2]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  # ===== TITLE =====
  - elementId: page-title
    elementType: text
    bounds: [60, 54, 1160, 40]
    content:
      style: "$title"
      align: [left, middle]
      wrap: false
      text: |
        <p>维度一总结：Source 识别技术演进</p>

  # ===== CARD 1: SaTC =====
  - elementId: card1-bg
    elementType: shape
    bounds: [60, 120, 360, 520]
    shapeName: roundRect
    adjustments: [6000]
    fill:
      type: solid
      color: "$panel"
    border:
      style: solid
      width: 1
      color: "$rule"

  - elementId: card1-accent
    elementType: shape
    bounds: [80, 140, 60, 4]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  - elementId: card1-title
    elementType: text
    bounds: [80, 156, 320, 36]
    content:
      fontSize: 24
      color: "$primary"
      fontFamily: "QuattrocentoSans, MiSans"
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>SaTC</strong></p>

  - elementId: card1-conf
    elementType: text
    bounds: [80, 196, 200, 22]
    content:
      style: "$caption"
      align: [left, middle]
      wrap: false
      text: |
        <p>USENIX Security 2021</p>

  - elementId: card1-line
    elementType: shape
    bounds: [80, 228, 320, 1]
    shapeName: rect
    fill:
      type: solid
      color: "$rule"

  - elementId: card1-sub1
    elementType: text
    bounds: [80, 240, 320, 26]
    content:
      fontSize: 18
      color: "$primary"
      fontFamily: "QuattrocentoSans, MiSans"
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>核心贡献</strong></p>

  - elementId: card1-body1
    elementType: text
    bounds: [80, 270, 320, 120]
    content:
      fontSize: 16
      color: "$text"
      fontFamily: "QuattrocentoSans, MiSans"
      lineHeight: 1.5
      align: [left, top]
      text: |
        <p>首次利用前后端共享关键词在二进制中定位输入入口。通过前端关键词提取→后端DRF定位→目标导向污点分析，检测命令注入和缓冲区溢出。</p>

  - elementId: card1-sub2
    elementType: text
    bounds: [80, 400, 320, 26]
    content:
      fontSize: 18
      color: "$primary"
      fontFamily: "QuattrocentoSans, MiSans"
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>关键数据</strong></p>

  - elementId: card1-body2
    elementType: text
    bounds: [80, 430, 320, 60]
    content:
      fontSize: 16
      color: "$text"
      fontFamily: "QuattrocentoSans, MiSans"
      lineHeight: 1.5
      align: [left, top]
      text: |
        <p>39固件 | 33 0-day | 30 CVE</p>

  - elementId: card1-sub3
    elementType: text
    bounds: [80, 500, 320, 26]
    content:
      fontSize: 18
      color: "$primary"
      fontFamily: "QuattrocentoSans, MiSans"
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>局限性</strong></p>

  - elementId: card1-body3
    elementType: text
    bounds: [80, 530, 320, 80]
    content:
      fontSize: 16
      color: "$text"
      fontFamily: "QuattrocentoSans, MiSans"
      lineHeight: 1.5
      align: [left, top]
      text: |
        <p>硬编码精确匹配导致漏报；Web依赖；前端混淆；隐藏接口无法覆盖</p>

