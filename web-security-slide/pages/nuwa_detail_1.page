pageType: content
background:
  type: solid
  color: "$background"
elements:
  # ===== NAV BAR =====
  - elementId: nav-bg
    elementType: shape
    bounds: [0, 0, 1280, 40]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"

  - elementId: nav-active
    elementType: shape
    bounds: [960, 0, 320, 40]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  - elementId: nav-t1
    elementType: text
    bounds: [0, 0, 320, 40]
    content:
      style: "$nav"
      align: [center, middle]
      wrap: false
      text: |
        <p>维度一: Source</p>

  - elementId: nav-t2
    elementType: text
    bounds: [320, 0, 320, 40]
    content:
      style: "$nav"
      align: [center, middle]
      wrap: false
      text: |
        <p>维度二: Propagation</p>

  - elementId: nav-t3
    elementType: text
    bounds: [640, 0, 320, 40]
    content:
      style: "$nav"
      align: [center, middle]
      wrap: false
      text: |
        <p>维度三: Sink</p>

  - elementId: nav-t4
    elementType: text
    bounds: [960, 0, 320, 40]
    content:
      style: "$nav"
      align: [center, middle]
      wrap: false
      text: |
        <p>维度四: Verification</p>

  - elementId: nav-line
    elementType: shape
    bounds: [0, 40, 1280, 2]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  # ===== TITLE & BADGE =====
  - elementId: page-title
    elementType: text
    bounds: [60, 54, 880, 40]
    content:
      style: "$title"
      align: [left, middle]
      wrap: false
      text: |
        <p>NÜWA — 前后端约束语义不一致性分析</p>

  - elementId: badge-bg
    elementType: shape
    bounds: [1050, 58, 170, 28]
    shapeName: roundRect
    adjustments: [8000]
    fill:
      type: solid
      color: "$accent"

  - elementId: badge-text
    elementType: text
    bounds: [1050, 58, 170, 28]
    content:
      style: "$badge"
      align: [center, middle]
      wrap: false
      text: |
        <p>USENIX Security 2025</p>

  # ===== LEFT COLUMN: 内容摘要 & 研究背景 =====
  - elementId: left-bar-1
    elementType: shape
    bounds: [60, 108, 4, 24]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  - elementId: left-subtitle-1
    elementType: text
    bounds: [72, 106, 348, 28]
    content:
      style: "$subtitle"
      align: [left, middle]
      wrap: false
      text: |
        <p>内容摘要</p>

  - elementId: left-body-1
    elementType: text
    bounds: [60, 142, 360, 190]
    content:
      style: "$body"
      align: [left, top]
      text: |
        <p>基于前后端约束语义不一致性的嵌入式Web服务漏洞检测。提取前端输入校验约束与后端安全处理约束，通过对比语义差异识别真实漏洞。在13个厂商基准上确认51个真实告警。</p>

  - elementId: left-bar-2
    elementType: shape
    bounds: [60, 348, 4, 24]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  - elementId: left-subtitle-2
    elementType: text
    bounds: [72, 346, 348, 28]
    content:
      style: "$subtitle"
      align: [left, middle]
      wrap: false
      text: |
        <p>研究背景</p>

  - elementId: left-body-2
    elementType: text
    bounds: [60, 382, 360, 230]
    content:
      style: "$body"
      align: [left, top]
      text: |
        <p>传统Source-Sink可达性分析忽略安全校验，导致大量误报。单一维度分析无法区分真正可利用的漏洞与理论上可达但受约束保护的路径。前后端约束不一致正是漏洞存在的核心信号。</p>

  # ===== MIDDLE COLUMN: 核心洞察 & 解决方案 =====
  - elementId: mid-bar-1
    elementType: shape
    bounds: [440, 108, 4, 24]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  - elementId: mid-subtitle-1
    elementType: text
    bounds: [452, 106, 348, 28]
    content:
      style: "$subtitle"
      align: [left, middle]
      wrap: false
      text: |
        <p>核心洞察</p>

  - elementId: mid-body-1
    elementType: text
    bounds: [440, 142, 360, 250]
    content:
      style: "$body"
      align: [left, top]
      text: |
        <p>漏洞本质不仅是Source-Sink可达，更是约束语义不一致。前端限制输入格式，后端却未校验或校验逻辑存在缺口，攻击者即可绕过前端约束直达危险Sink。将漏洞检测转化为约束一致性验证问题。</p>

  - elementId: mid-bar-2
    elementType: shape
    bounds: [440, 400, 4, 24]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  - elementId: mid-subtitle-2
    elementType: text
    bounds: [452, 398, 348, 28]
    content:
      style: "$subtitle"
      align: [left, middle]
      wrap: false
      text: |
        <p>解决方案</p>

  - elementId: mid-body-2
    elementType: text
    bounds: [440, 434, 360, 250]
    content:
      style: "$body"
      align: [left, top]
      text: |
        <p>1. 前端约束提取：解析HTML/JS中的输入校验规则（maxlength、正则、枚举）。2. 后端函数摘要：对后端处理函数进行切片，提取安全校验语义。3. 后端约束提取：识别长度检查、字符过滤、路径规范化等约束。4. 不一致性静态分析：对比前后端约束集合，标记不一致路径为真实漏洞。</p>

  # ===== RIGHT COLUMN: 关键数据 =====
  - elementId: right-bar
    elementType: shape
    bounds: [820, 108, 4, 24]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  - elementId: right-subtitle
    elementType: text
    bounds: [832, 106, 348, 28]
    content:
      style: "$subtitle"
      align: [left, middle]
      wrap: false
      text: |
        <p>关键数据</p>

  # Card 1
  - elementId: card1-bg
    elementType: shape
    bounds: [840, 150, 340, 120]
    shapeName: roundRect
    adjustments: [8000]
    fill:
      type: solid
      color: "$panel"
    border:
      style: solid
      width: 1
      color: "$rule"

  - elementId: card1-num
    elementType: text
    bounds: [860, 165, 300, 42]
    content:
      style: "$kpi"
      align: [left, middle]
      wrap: false
      text: |
        <p>51</p>

  - elementId: card1-label
    elementType: text
    bounds: [860, 215, 300, 24]
    content:
      style: "$caption"
      align: [left, middle]
      wrap: false
      text: |
        <p>个真实告警确认</p>

  # Card 2
  - elementId: card2-bg
    elementType: shape
    bounds: [840, 290, 340, 120]
    shapeName: roundRect
    adjustments: [8000]
    fill:
      type: solid
      color: "$panel"
    border:
      style: solid
      width: 1
      color: "$rule"

  - elementId: card2-num
    elementType: text
    bounds: [860, 305, 300, 42]
    content:
      style: "$kpi"
      align: [left, middle]
      wrap: false
      text: |
        <p>76%</p>

  - elementId: card2-label
    elementType: text
    bounds: [860, 355, 300, 24]
    content:
      style: "$caption"
      align: [left, middle]
      wrap: false
      text: |
        <p>漏洞检测准确率</p>

  # Card 3
  - elementId: card3-bg
    elementType: shape
    bounds: [840, 430, 340, 120]
    shapeName: roundRect
    adjustments: [8000]
    fill:
      type: solid
      color: "$panel"
    border:
      style: solid
      width: 1
      color: "$rule"

  - elementId: card3-num
    elementType: text
    bounds: [860, 445, 300, 42]
    content:
      style: "$kpi"
      align: [left, middle]
      wrap: false
      text: |
        <p>95%</p>

  - elementId: card3-label
    elementType: text
    bounds: [860, 495, 300, 24]
    content:
      style: "$caption"
      align: [left, middle]
      wrap: false
      text: |
        <p>约束提取准确率</p>

  # ===== FOOTER =====
  - elementId: footer-left
    elementType: text
    bounds: [60, 690, 400, 20]
    content:
      style: "$caption"
      align: [left, middle]
      wrap: false
      text: |
        <p>网络设备Web服务安全研究</p>

  - elementId: footer-right
    elementType: text
    bounds: [1100, 690, 120, 20]
    content:
      style: "$caption"
      align: [right, middle]
      wrap: false
      text: |
        <p>29 / 37</p>
