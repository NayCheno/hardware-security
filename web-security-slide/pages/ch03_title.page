pageType: chapter
background:
  type: solid
  color: "#1E293B"
elements:
  - elementId: right-panel
    elementType: shape
    bounds: [853, 0, 427, 720]
    shapeName: rect
    fill:
      type: gradient
      gradientType: linear
      angle: 0
      stops:
        - {position: 0, color: "#1E293B"}
        - {position: 1, color: "#0F172A"}

  - elementId: ch-num
    elementType: text
    bounds: [60, 140, 500, 160]
    content:
      style: "$chapterNum"
      align: [left, middle]
      wrap: false
      text: |
        <p>03</p>

  - elementId: accent-line
    elementType: shape
    bounds: [60, 320, 60, 4]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  - elementId: ch-title
    elementType: text
    bounds: [60, 340, 740, 48]
    content:
      style: "$chapterTitle"
      align: [left, middle]
      wrap: false
      text: |
        <p>隐藏接口发现（Sink）</p>

  - elementId: ch-subtitle
    elementType: text
    bounds: [60, 400, 740, 32]
    content:
      style: "$chapterSubtitle"
      align: [left, middle]
      wrap: false
      text: |
        <p>从盲测到智能推断</p>

  - elementId: ch-intro
    elementType: text
    bounds: [60, 460, 740, 100]
    content:
      fontSize: 18
      color: "#CBD5E1"
      fontFamily: "QuattrocentoSans, MiSans"
      lineHeight: 1.6
      align: [left, top]
      text: |
        <p>核心痛点：IoT设备往往包含大量因历史遗留或调试所需的隐藏Web接口，无文档、无入口、无认证，成为重大安全隐患。</p>
        <p>技术演进：静态解析与盲测 → 路由分析与LLM推断 → 多语言接口规格恢复</p>

  - elementId: ch-papers
    elementType: text
    bounds: [60, 600, 740, 60]
    content:
      fontSize: 14
      color: "#94A3B8"
      fontFamily: "QuattrocentoSans, MiSans"
      lineHeight: 1.6
      align: [left, top]
      text: |
        <p>IoTScope (WWW 2022)  →  EAGLEYE (NDSS 2025)  →  PANGOLIN (USENIX Security 2026)</p>
