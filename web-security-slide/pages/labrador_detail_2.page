pageType: content
background:
  type: solid
  color: "$background"
elements:
  # ===== NAV BAR =====
  - elementId: nav-bg
    elementType: shape
    bounds: [0, 0, 1280, 40]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"

  - elementId: nav-active
    elementType: shape
    bounds: [960, 0, 320, 40]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  - elementId: nav-t1
    elementType: text
    bounds: [0, 0, 320, 40]
    content:
      style: "$nav"
      align: [center, middle]
      wrap: false
      text: |
        <p>维度一: Source</p>

  - elementId: nav-t2
    elementType: text
    bounds: [320, 0, 320, 40]
    content:
      style: "$nav"
      align: [center, middle]
      wrap: false
      text: |
        <p>维度二: Propagation</p>

  - elementId: nav-t3
    elementType: text
    bounds: [640, 0, 320, 40]
    content:
      style: "$nav"
      align: [center, middle]
      wrap: false
      text: |
        <p>维度三: Sink</p>

  - elementId: nav-t4
    elementType: text
    bounds: [960, 0, 320, 40]
    content:
      style: "$nav"
      align: [center, middle]
      wrap: false
      text: |
        <p>维度四: Verification</p>

  - elementId: nav-line
    elementType: shape
    bounds: [0, 40, 1280, 2]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  # ===== TITLE & BADGE =====
  - elementId: page-title
    elementType: text
    bounds: [60, 54, 880, 40]
    content:
      style: "$title"
      align: [left, middle]
      wrap: false
      text: |
        <p>LABRADOR — 实验结果与文章评价</p>

  - elementId: badge-bg
    elementType: shape
    bounds: [1050, 58, 170, 28]
    shapeName: roundRect
    adjustments: [8000]
    fill:
      type: solid
      color: "$accent"

  - elementId: badge-text
    elementType: text
    bounds: [1050, 58, 170, 28]
    content:
      style: "$badge"
      align: [center, middle]
      wrap: false
      text: |
        <p>IEEE S&P 2024</p>

  # ===== EXPERIMENTAL RESULTS =====
  - elementId: results-bar
    elementType: shape
    bounds: [60, 108, 4, 24]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  - elementId: results-subtitle
    elementType: text
    bounds: [72, 106, 348, 28]
    content:
      style: "$subtitle"
      align: [left, middle]
      wrap: false
      text: |
        <p>实验结果</p>

  - elementId: results-table
    elementType: table
    bounds: [60, 148, 600, 240]
    columnWidths: [0.5, 0.5]
    rowHeights: [0.15, 0.17, 0.17, 0.17, 0.17, 0.17]
    style: "$default"
    rows:
      - - content: {text: "评估指标"}
        - content: {text: "数值"}
      - - content: {text: "测试设备"}
        - content: {text: "14台企业级"}
      - - content: {text: "0-day漏洞"}
        - content: {text: "79个 (含61 CVE)"}
      - - content: {text: "vs SNIPUZZ/BOOFUZZ"}
        - content: {text: "44倍"}
      - - content: {text: "vs SaTC"}
        - content: {text: "8.57倍"}
      - - content: {text: "设备类型"}
        - content: {text: "路由器/交换机/AP"}

  - elementId: results-note
    elementType: text
    bounds: [700, 148, 520, 240]
    content:
      style: "$body"
      align: [left, top]
      text: |
        <p><strong>与现有方法对比</strong></p>
        <p>相比静态分析工具，LABRADOR在真实设备上验证，不受隐式控制流缺失和字符串匹配规则限制。相比传统黑盒Fuzzer，利用响应反馈实现定向变异，效率提升一个数量级。</p>

  # ===== ARTICLE EVALUATION =====
  - elementId: eval-bar
    elementType: shape
    bounds: [60, 410, 4, 24]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  - elementId: eval-subtitle
    elementType: text
    bounds: [72, 408, 348, 28]
    content:
      style: "$subtitle"
      align: [left, middle]
      wrap: false
      text: |
        <p>文章评价</p>

  # Evaluation: 优势
  - elementId: eval1-bar
    elementType: shape
    bounds: [60, 452, 4, 24]
    shapeName: rect
    fill:
      type: solid
      color: "$success"

  - elementId: eval1-subtitle
    elementType: text
    bounds: [72, 450, 348, 28]
    content:
      fontSize: 18
      color: "$success"
      fontFamily: "QuattrocentoSans, MiSans"
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>优势</strong></p>

  - elementId: eval1-body
    elementType: text
    bounds: [60, 486, 360, 180]
    content:
      style: "$body"
      align: [left, top]
      text: |
        <p>通过响应字符串近似恢复黑盒执行轨迹，无需插桩即可实现定向Fuzzing。在真实企业级设备上验证，发现漏洞数量远超现有工具。</p>

  # Evaluation: 局限
  - elementId: eval2-bar
    elementType: shape
    bounds: [440, 452, 4, 24]
    shapeName: rect
    fill:
      type: solid
      color: "$risk"

  - elementId: eval2-subtitle
    elementType: text
    bounds: [452, 450, 348, 28]
    content:
      fontSize: 18
      color: "$risk"
      fontFamily: "QuattrocentoSans, MiSans"
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>局限</strong></p>

  - elementId: eval2-body
    elementType: text
    bounds: [440, 486, 360, 180]
    content:
      style: "$body"
      align: [left, top]
      text: |
        <p>依赖响应中包含可匹配字符串，静默接口或响应极少的设备反馈质量下降。设备重启和恢复机制需要稳定支持。</p>

  # Evaluation: 商业化
  - elementId: eval3-bar
    elementType: shape
    bounds: [820, 452, 4, 24]
    shapeName: rect
    fill:
      type: solid
      color: "$secondary"

  - elementId: eval3-subtitle
    elementType: text
    bounds: [832, 450, 348, 28]
    content:
      fontSize: 18
      color: "$secondary"
      fontFamily: "QuattrocentoSans, MiSans"
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>商业化</strong></p>

  - elementId: eval3-body
    elementType: text
    bounds: [820, 486, 360, 180]
    content:
      style: "$body"
      align: [left, top]
      text: |
        <p>需稳定设备重启恢复机制，适合有设备实验室的安全厂商。可与设备供应链合作，在发布前进行黑盒验证测试。</p>

  # ===== FOOTER =====
  - elementId: footer-left
    elementType: text
    bounds: [60, 690, 400, 20]
    content:
      style: "$caption"
      align: [left, middle]
      wrap: false
      text: |
        <p>网络设备Web服务安全研究</p>

  - elementId: footer-right
    elementType: text
    bounds: [1100, 690, 120, 20]
    content:
      style: "$caption"
      align: [right, middle]
      wrap: false
      text: |
        <p>32 / 37</p>
