pageType: content
background:
  type: solid
  color: "$background"
elements:
  # ===== NAV BAR =====
  - elementId: nav-bg
    elementType: shape
    bounds: [0, 0, 1280, 40]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"

  - elementId: nav-active
    elementType: shape
    bounds: [320, 0, 320, 40]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  - elementId: nav-t1
    elementType: text
    bounds: [0, 0, 320, 40]
    content:
      style: "$nav"
      align: [center, middle]
      wrap: false
      text: |
        <p>维度一: Source</p>

  - elementId: nav-t2
    elementType: text
    bounds: [320, 0, 320, 40]
    content:
      style: "$nav"
      align: [center, middle]
      wrap: false
      text: |
        <p>维度二: Propagation</p>

  - elementId: nav-t3
    elementType: text
    bounds: [640, 0, 320, 40]
    content:
      style: "$nav"
      align: [center, middle]
      wrap: false
      text: |
        <p>维度三: Sink</p>

  - elementId: nav-t4
    elementType: text
    bounds: [960, 0, 320, 40]
    content:
      style: "$nav"
      align: [center, middle]
      wrap: false
      text: |
        <p>维度四: Verification</p>

  - elementId: nav-line
    elementType: shape
    bounds: [0, 40, 1280, 2]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  # ===== TITLE & BADGE =====
  - elementId: page-title
    elementType: text
    bounds: [60, 54, 880, 40]
    content:
      style: "$title"
      align: [left, middle]
      wrap: false
      text: |
        <p>OctopusTaint — 实验结果与文章评价</p>

  - elementId: badge-bg
    elementType: shape
    bounds: [1060, 58, 140, 28]
    shapeName: roundRect
    adjustments: [8000]
    fill:
      type: solid
      color: "$accent"

  - elementId: badge-text
    elementType: text
    bounds: [1060, 58, 140, 28]
    content:
      style: "$badge"
      align: [center, middle]
      wrap: false
      text: |
        <p>ACM CCS 2024</p>

  # ===== EXPERIMENTAL RESULTS =====
  - elementId: results-bar
    elementType: shape
    bounds: [60, 108, 4, 24]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  - elementId: results-subtitle
    elementType: text
    bounds: [72, 106, 348, 28]
    content:
      style: "$subtitle"
      align: [left, middle]
      wrap: false
      text: |
        <p>实验结果</p>

  - elementId: results-table
    elementType: table
    bounds: [60, 148, 600, 240]
    columnWidths: [0.5, 0.5]
    rowHeights: [0.15, 0.17, 0.17, 0.17, 0.17, 0.17]
    style: "$default"
    rows:
      - - content: {text: "评估指标"}
        - content: {text: "数值"}
      - - content: {text: "0-day 漏洞验证"}
        - content: {text: "49 个"}
      - - content: {text: "大规模固件数据集"}
        - content: {text: "1,542 个"}
      - - content: {text: "对比 SaTC 速度"}
        - content: {text: "快 24%"}
      - - content: {text: "复杂间接调用召回率"}
        - content: {text: "83%"}
      - - content: {text: "高危警告过滤"}
        - content: {text: "109 个"}

  - elementId: results-note
    elementType: text
    bounds: [700, 148, 520, 240]
    content:
      style: "$body"
      align: [left, top]
      text: |
        <p><strong>与现有方法对比</strong></p>
        <p>同为基于RDA的工具，MangoDFA在复杂间接调用和超多参数格式化场景下召回率仅16%。OctopusTaint凭借AIL优化和底层修复，召回率高达83%。净化检查成功识别了320个已被净化的误报汇聚点。</p>

  # ===== ARTICLE EVALUATION =====
  - elementId: eval-bar
    elementType: shape
    bounds: [60, 410, 4, 24]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  - elementId: eval-subtitle
    elementType: text
    bounds: [72, 408, 348, 28]
    content:
      style: "$subtitle"
      align: [left, middle]
      wrap: false
      text: |
        <p>文章评价</p>

  # Evaluation: 优势
  - elementId: eval1-bar
    elementType: shape
    bounds: [60, 452, 4, 24]
    shapeName: rect
    fill:
      type: solid
      color: "$success"

  - elementId: eval1-subtitle
    elementType: text
    bounds: [72, 450, 348, 28]
    content:
      fontSize: 18
      color: "$success"
      fontFamily: "QuattrocentoSans, MiSans"
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>优势</strong></p>

  - elementId: eval1-body
    elementType: text
    bounds: [60, 486, 360, 180]
    content:
      style: "$body"
      align: [left, top]
      text: |
        <p>误报来源处理极为细致。AIL底层优化、净化检查、NVRAM路径拼接、新污点源发现与间接调用解析形成完整链条，专门解决了真实固件中最常见的误报/漏报来源。</p>

  # Evaluation: 局限
  - elementId: eval2-bar
    elementType: shape
    bounds: [440, 452, 4, 24]
    shapeName: rect
    fill:
      type: solid
      color: "$risk"

  - elementId: eval2-subtitle
    elementType: text
    bounds: [452, 450, 348, 28]
    content:
      fontSize: 18
      color: "$risk"
      fontFamily: "QuattrocentoSans, MiSans"
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>局限</strong></p>

  - elementId: eval2-body
    elementType: text
    bounds: [440, 486, 360, 180]
    content:
      style: "$body"
      align: [left, top]
      text: |
        <p>依赖angr、AIL、DDG等底层框架质量，若反编译或DDG构建失败则整个分析失效。对固件架构和反编译质量要求较高。</p>

  # Evaluation: 商业化
  - elementId: eval3-bar
    elementType: shape
    bounds: [820, 452, 4, 24]
    shapeName: rect
    fill:
      type: solid
      color: "$secondary"

  - elementId: eval3-subtitle
    elementType: text
    bounds: [832, 450, 348, 28]
    content:
      fontSize: 18
      color: "$secondary"
      fontFamily: "QuattrocentoSans, MiSans"
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>商业化</strong></p>

  - elementId: eval3-body
    elementType: text
    bounds: [820, 486, 360, 180]
    content:
      style: "$body"
      align: [left, top]
      text: |
        <p>适合高精度静态分析后端、大型设备厂商内部安全平台。可作为现有供应链扫描引擎的精度增强模块。</p>

  # ===== FOOTER =====
  - elementId: footer-left
    elementType: text
    bounds: [60, 690, 400, 20]
    content:
      style: "$caption"
      align: [left, middle]
      wrap: false
      text: |
        <p>网络设备Web服务安全研究</p>

  - elementId: footer-right
    elementType: text
    bounds: [1100, 690, 120, 20]
    content:
      style: "$caption"
      align: [right, middle]
      wrap: false
      text: |
        <p>18 / 37</p>
