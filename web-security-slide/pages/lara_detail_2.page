pageType: content
background:
  type: solid
  color: "$background"
elements:
  # ===== NAV BAR =====
  - elementId: nav-bg
    elementType: shape
    bounds: [0, 0, 1280, 40]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"

  - elementId: nav-active
    elementType: shape
    bounds: [0, 0, 320, 40]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  - elementId: nav-t1
    elementType: text
    bounds: [0, 0, 320, 40]
    content:
      style: "$nav"
      align: [center, middle]
      wrap: false
      text: |
        <p>维度一: Source</p>

  - elementId: nav-t2
    elementType: text
    bounds: [320, 0, 320, 40]
    content:
      style: "$nav"
      align: [center, middle]
      wrap: false
      text: |
        <p>维度二: Propagation</p>

  - elementId: nav-t3
    elementType: text
    bounds: [640, 0, 320, 40]
    content:
      style: "$nav"
      align: [center, middle]
      wrap: false
      text: |
        <p>维度三: Sink</p>

  - elementId: nav-t4
    elementType: text
    bounds: [960, 0, 320, 40]
    content:
      style: "$nav"
      align: [center, middle]
      wrap: false
      text: |
        <p>维度四: Verification</p>

  - elementId: nav-line
    elementType: shape
    bounds: [0, 40, 1280, 2]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  # ===== TITLE & BADGE =====
  - elementId: page-title
    elementType: text
    bounds: [60, 54, 880, 40]
    content:
      style: "$title"
      align: [left, middle]
      wrap: false
      text: |
        <p>LARA — 实验结果与文章评价</p>

  - elementId: badge-bg
    elementType: shape
    bounds: [1050, 58, 170, 28]
    shapeName: roundRect
    adjustments: [8000]
    fill:
      type: solid
      color: "$accent"

  - elementId: badge-text
    elementType: text
    bounds: [1050, 58, 170, 28]
    content:
      style: "$badge"
      align: [center, middle]
      wrap: false
      text: |
        <p>USENIX Security 2024</p>

  # ===== EXPERIMENTAL RESULTS =====
  - elementId: results-bar
    elementType: shape
    bounds: [60, 108, 4, 24]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  - elementId: results-subtitle
    elementType: text
    bounds: [72, 106, 348, 28]
    content:
      style: "$subtitle"
      align: [left, middle]
      wrap: false
      text: |
        <p>实验结果</p>

  - elementId: results-table
    elementType: table
    bounds: [60, 148, 500, 280]
    columnWidths: [0.5, 0.5]
    rowHeights: [0.13, 0.145, 0.145, 0.145, 0.145, 0.145, 0.145]
    style: "$default"
    rows:
      - - content: {text: "关键指标"}
        - content: {text: "数值"}
      - - content: {text: "设备固件"}
        - content: {text: "203 款"}
      - - content: {text: "URI 提取提升"}
        - content: {text: "5.4x"}
      - - content: {text: "Key 提取提升"}
        - content: {text: "4.7x"}
      - - content: {text: "误报率降低"}
        - content: {text: "57%"}
      - - content: {text: "0-day 漏洞"}
        - content: {text: "245 个"}
      - - content: {text: "CVE 编号"}
        - content: {text: "162 个"}

  - elementId: results-note
    elementType: text
    bounds: [600, 148, 620, 280]
    content:
      style: "$body"
      align: [left, top]
      text: |
        <p><strong>与现有方法对比</strong></p>
        <p>相比 SaTC 多发现 556 个漏洞，相比 KARONTE 多发现 602 个漏洞。</p>
        <p>分析时间减少 65.5%，所有漏洞均已被厂商确认或修复。</p>
        <p>在 21 个厂商、203 款设备的真实固件数据集上全面评估。</p>

  # ===== ARTICLE EVALUATION =====
  - elementId: eval-bar
    elementType: shape
    bounds: [60, 450, 4, 24]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"

  - elementId: eval-subtitle
    elementType: text
    bounds: [72, 448, 348, 28]
    content:
      style: "$subtitle"
      align: [left, middle]
      wrap: false
      text: |
        <p>文章评价</p>

  - elementId: eval1-bar
    elementType: shape
    bounds: [60, 492, 4, 24]
    shapeName: rect
    fill:
      type: solid
      color: "$success"

  - elementId: eval1-subtitle
    elementType: text
    bounds: [72, 490, 348, 28]
    content:
      fontSize: 18
      color: "$success"
      fontFamily: "QuattrocentoSans, MiSans"
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>优势</strong></p>

  - elementId: eval1-body
    elementType: text
    bounds: [60, 526, 360, 130]
    content:
      style: "$body"
      align: [left, top]
      text: |
        <p>把源点识别从字符串层推进到代码意图层，对Source识别能力更出色。URI-Key结构化建模显著提升覆盖率和精确度。</p>

  - elementId: eval2-bar
    elementType: shape
    bounds: [440, 492, 4, 24]
    shapeName: rect
    fill:
      type: solid
      color: "$risk"

  - elementId: eval2-subtitle
    elementType: text
    bounds: [452, 490, 348, 28]
    content:
      fontSize: 18
      color: "$risk"
      fontFamily: "QuattrocentoSans, MiSans"
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>局限</strong></p>

  - elementId: eval2-body
    elementType: text
    bounds: [440, 526, 360, 130]
    content:
      style: "$body"
      align: [left, top]
      text: |
        <p>① LLM引入成本、稳定性和可复现性问题；② LLM效果依赖反编译代码片段质量。</p>

  - elementId: eval3-bar
    elementType: shape
    bounds: [820, 492, 4, 24]
    shapeName: rect
    fill:
      type: solid
      color: "$secondary"

  - elementId: eval3-subtitle
    elementType: text
    bounds: [832, 490, 348, 28]
    content:
      fontSize: 18
      color: "$secondary"
      fontFamily: "QuattrocentoSans, MiSans"
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>商业化</strong></p>

  - elementId: eval3-body
    elementType: text
    bounds: [820, 526, 360, 130]
    content:
      style: "$body"
      align: [left, top]
      text: |
        <p>适合新一代基于大模型的Source识别技术。但需要提示词固化、缓存、本地模型或审核流程来降低不确定性。</p>

  # ===== FOOTER =====
  - elementId: footer-left
    elementType: text
    bounds: [60, 690, 400, 20]
    content:
      style: "$caption"
      align: [left, middle]
      wrap: false
      text: |
        <p>网络设备Web服务安全研究</p>

  - elementId: footer-right
    elementType: text
    bounds: [1100, 690, 120, 20]
    content:
      style: "$caption"
      align: [right, middle]
      wrap: false
      text: |
        <p>10 / 37</p>
