      color: "$accent"

  - elementId: card1-title
    elementType: text
    bounds: [80, 156, 320, 36]
    content:
      fontSize: 24
      color: "$primary"
      fontFamily: "QuattrocentoSans, MiSans"
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>NÜWA</strong></p>

  - elementId: card1-conf
    elementType: text
    bounds: [80, 196, 200, 22]
