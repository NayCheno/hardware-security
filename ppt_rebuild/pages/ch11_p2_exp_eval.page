pageType: content
background:
  type: solid
  color: "#FFFFFF"
elements:
- elementId: top-bar
  elementType: shape
  bounds: [0, 0, 1280, 6]
  shapeName: rect
  fill:
    type: solid
    color: $primary
- elementId: badge-bg
  elementType: shape
  bounds: [60, 14, 120, 22]
  shapeName: rect
  fill:
    type: solid
    color: $primary
- elementId: badge-text
  elementType: text
  bounds: [60, 14, 120, 22]
  content:
    fontSize: 12
    color: #FFFFFF
    fontFamily: Inter, MiSans
    lineHeight: 1.0
    align: [center, middle]
    wrap: False
    text: |
      CH11
- elementId: exp-title
  elementType: text
  bounds: [60, 40, 300, 35]
  content:
    fontSize: 24
    color: $primary
    fontFamily: Inter, MiSans
    lineHeight: 1.5
    wrap: True
    text: |
      <p><strong>实验结果</strong></p>
- elementId: exp-body
  elementType: text
  bounds: [60, 80, 1160, 230]
  content:
    fontSize: 18
    color: $text
    fontFamily: Inter, MiSans
    lineHeight: 1.5
    wrap: True
    text: |
      <ul>
      <li>MICRO 2007 peer-reviewed secure-processor simulation。</li>
      <li>Historical performance numbers are lineage evidence, not direct CCA/SEV-SNP product proof。</li>
      <li>本地 PDF 已核验，可进入本方向演进图，但不能替代更强证据。</li>
      </ul>
- elementId: eval-title
  elementType: text
  bounds: [60, 330, 300, 35]
  content:
    fontSize: 24
    color: $primary
    fontFamily: Inter, MiSans
    lineHeight: 1.5
    wrap: True
    text: |
      <p><strong>文章评价</strong></p>
- elementId: eval-table
  elementType: table
  bounds: [60, 370, 1160, 280]
  columnWidths: [0.2000, 0.8000]
  rowHeights: [0.2000, 0.2000, 0.2000, 0.2000, 0.2000]
  style: $default
  rows:
    -
      - content: {text: "维度"}
      - content: {text: "判断"}
    -
      - content: {text: "设计优势"}
      - content: {text: "Moves the section anchor from vendor/spec contrast back to peer-reviewed memory-integrity mechanism。"}
    -
      - content: {text: "主要局限"}
      - content: {text: "Secure-processor lineage is not the same as a modern confidential-VM product implementation。"}
    -
      - content: {text: "商业落地"}
      - content: {text: "Useful for memory-controller integrity-tree design; productization depends on platform integration。"}
    -
      - content: {text: "讲稿定位"}
      - content: {text: "代表性改进；证据强度 E1"}
- elementId: source
  elementType: text
  bounds: [60, 690, 1160, 20]
  content:
    fontSize: 14
    color: $secondary
    fontFamily: Inter, MiSans
    lineHeight: 1.2
    wrap: True
    text: |
      来源：Bonsai Merkle Trees for memory integrity and freshness｜证据等级：E1 / Peer-reviewed mechanism anchor
- elementId: bottom-bar
  elementType: shape
  bounds: [0, 714, 1280, 6]
  shapeName: rect
  fill:
    type: solid
    color: $primary
