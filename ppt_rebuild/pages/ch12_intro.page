pageType: chapter
background:
  type: solid
  color: "#FFFFFF"
elements:
- elementId: top-bar
  elementType: shape
  bounds: [0, 0, 1280, 6]
  shapeName: rect
  fill:
    type: solid
    color: $primary
- elementId: left-bar
  elementType: shape
  bounds: [60, 120, 4, 80]
  shapeName: rect
  fill:
    type: solid
    color: $primary
- elementId: title
  elementType: text
  bounds: [80, 110, 1100, 50]
  content:
    fontSize: 36
    color: $primary
    fontFamily: Inter, MiSans
    lineHeight: 1.5
    wrap: True
    text: |
      <p><strong>方向12：Memory / I/O Fabrics</strong></p>
- elementId: subtitle
  elementType: text
  bounds: [80, 160, 1100, 35]
  content:
    fontSize: 24
    color: $secondary
    fontFamily: Inter, MiSans
    lineHeight: 1.5
    wrap: True
