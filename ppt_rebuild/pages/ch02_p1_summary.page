pageType: content
background:
  type: solid
  color: "$background"
elements:
  - elementId: left-accent
    elementType: shape
    bounds: [60, 60, 4, 40]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"
  - elementId: title
    elementType: text
    bounds: [80, 55, 900, 40]
    content:
      fontSize: 28
      color: "$primary"
      fontFamily: "Inter, MiSans"
      wrap: false
      text: |
        <p><strong>Arm TrustZone 白皮书 — 内容摘要</strong></p>
  - elementId: badge-bg
    elementType: shape
    bounds: [1060, 55, 160, 30]
    shapeName: roundRect
    adjustments: [10000]
    fill:
      type: solid
      color: "$accent"
  - elementId: badge-text
    elementType: text
    bounds: [1060, 55, 160, 30]
    content:
      fontSize: 12
      color: "#FFFFFF"
      fontFamily: "Inter, MiSans"
      align: [center, middle]
      wrap: false
      text: |
        <p>E4 / 基础产业证据</p>
  - elementId: content
    elementType: text
    bounds: [80, 110, 1100, 480]
    content:
      fontSize: 18
      color: "$text"
      fontFamily: "Inter, MiSans"
      lineHeight: 1.5
      text: |
        <p><strong>核心贡献：</strong>First-party Arm TrustZone whitepaper 定义 Secure/Non-secure world、NS bit 和 SoC 级隔离的基本模型，是 Arm TEE 最强的基础机制来源。</p>
        <p style="margin-top:12px"><strong>关键要点：</strong></p>
        <ul>
        <li>Secure world 和 Non-secure world 的双世界模型</li>
        <li>NS bit 在处理器、互连和外设路径传播安全状态</li>
        <li>Secure monitor 作为 world switch 的 trusted 边界</li>
        <li>历史基础价值高，能解释 Arm TEE 的双世界起点</li>
        </ul>
  - elementId: source
    elementType: text
    bounds: [80, 660, 1100, 25]
    content:
      fontSize: 14
      color: "$secondary"
      fontFamily: "Inter, MiSans"
      wrap: false
      text: |
        <p>来源：Arm TrustZone 白皮书; local PDF 已核验</p>