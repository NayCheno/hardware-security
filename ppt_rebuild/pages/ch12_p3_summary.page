    type: solid
    color: $primary
- elementId: badge-bg
  elementType: shape
  bounds: [60, 10, 120, 18]
  shapeName: rect
  fill:
    type: solid
    color: $primary
- elementId: badge-text
  elementType: text
  bounds: [60, 10, 120, 18]
  content:
    fontSize: 12
    color: #FFFFFF
    fontFamily: Inter, MiSans
    lineHeight: 1.0
    align: [center, middle]
