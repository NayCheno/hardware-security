pageType: content
background:
  type: solid
  color: "#FFFFFF"
elements:
- elementId: top-bar
  elementType: shape
  bounds: [0, 0, 1280, 6]
  shapeName: rect
  fill:
    type: solid
    color: $primary
- elementId: title
  elementType: text
  bounds: [60, 30, 500, 45]
  content:
    fontSize: 32
    color: $primary
    fontFamily: Inter, MiSans
    lineHeight: 1.5
    wrap: True
    text: |
      <p><strong>方向总结</strong></p>
- elementId: title-line
  elementType: shape
  bounds: [60, 78, 120, 3]
  shapeName: rect
  fill:
    type: solid
    color: $primary
- elementId: summary-table
  elementType: table
  bounds: [60, 90, 1160, 570]
  columnWidths: [0.2500, 0.3000, 0.3000, 0.1500]
  rowHeights: [0.2500, 0.2500, 0.2500, 0.2500]
  style: $default
  rows:
    -
      - content: {text: "论文"}
      - content: {text: "核心思想"}
      - content: {text: "主要局限"}
      - content: {text: "证据等级"}
    -
      - content: {text: "DirectCXL"}
      - content: {text: "把远端内存变成 host 可直接 load/store 的 CXL.mem 地址空间"}
      - content: {text: "不覆盖 CXL IDE、SPDM/TDISP、attestation、multi-tenant memory ownership 或 verifier policy"}
      - content: {text: "E1 / Peer-reviewed"}
    -
      - content: {text: "CXL-Tiers"}
      - content: {text: "在 VM 云环境里把硬件 tiering 与软件隔离策略组合起来"}
      - content: {text: "Intel Flat Memory Mode 依赖特定处理器/MC 能力，不解决 CXL IDE keying、attestation 或 confidential VM ownership"}
      - content: {text: "E1 / Peer-reviewed"}
    -
      - content: {text: "ODRP"}
      - content: {text: "把 remote paging 的内存管理搬进 RNIC data path，实现 zero MNode CPU"}
      - content: {text: "WR-chain 编程复杂，empty free queue、CNode crash、TT recovery 等 corner cases 仍需 MNode CPU 或额外 recovery 逻辑"}
      - content: {text: "E1 / Peer-reviewed"}
- elementId: source
  elementType: text
  bounds: [60, 690, 1160, 20]
  content:
    fontSize: 14
    color: $secondary
    fontFamily: Inter, MiSans
    lineHeight: 1.2
    wrap: True
    text: |
      来源：三篇主讲材料选择、评价字段与 evidence ledger｜证据等级：方向综述
- elementId: bottom-bar
  elementType: shape
  bounds: [0, 714, 1280, 6]
  shapeName: rect
  fill:
    type: solid
    color: $primary
