pageType: content
background:
  type: solid
  color: "$background"
elements:
  - elementId: top-bar
    elementType: shape
    bounds: [0, 0, 1280, 6]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"
  - elementId: dir-badge-bg
    elementType: shape
    bounds: [60, 30, 100, 24]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"
  - elementId: dir-badge-text
    elementType: text
    bounds: [60, 30, 100, 24]
    content:
      fontSize: 12
      color: "$white"
      align: [center, middle]
      wrap: false
      text: |
        <p>SmartNIC / trusted NIC...</p>
  - elementId: page-title
    elementType: text
    bounds: [60, 56, 500, 40]
    content:
      style: "$title"
      fontSize: 32
      color: "$primary"
      align: [left, middle]
      wrap: false
      text: |
        <p>方向总结</p>
  - elementId: title-underline
    elementType: shape
    bounds: [60, 100, 120, 3]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"
  - elementId: summary-table
    elementType: table
    bounds: [60, 120, 1160, 560]
    columnWidths: [0.25, 0.15, 0.35, 0.25]
    rowHeights: [0.1, 0.3, 0.3, 0.3]
    style: "$default"
    rows:
      - - content:
            text: |
              论文
        - content:
            text: |
              定位
        - content:
            text: |
              选择理由
      - - content:
            text: |
              - 'S-NIC: SmartNIC function isolation
        - content:
            text: |
              开创/基础入口
        - content:
            text: |
              sNIC is the foundational peer-reviewed systems paper for cloud SmartNIC...
      - - content:
            text: |
              - 'TNIC: trusted NIC architecture
        - content:
            text: |
              代表性改进
        - content:
            text: |
              TNIC is a peer-reviewed ASPLOS 2025 SOTA trusted NIC system.
      - - content:
            text: |
              - 'Hazel: secure disaggregated storage data path
        - content:
            text: |
              当前 SOTA/补充边界
        - content:
            text: |
              Hazel is retained as a draft SOTA item for trusted NIC and secure...
  - elementId: bottom-bar
    elementType: shape
    bounds: [0, 714, 1280, 6]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"
