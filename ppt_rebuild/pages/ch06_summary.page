            align: [center, middle]
      - - content:
            text: |
              <p>SWATT</p>
            align: [center, middle]
        - content:
            text: |
              <p>Timing-sensitive 软件校验</p>
            align: [left, middle]
        - content:
            text: |
              <p>现代强对手适用性有限</p>
