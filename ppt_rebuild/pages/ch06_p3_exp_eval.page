pageType: content
background:
  type: solid
  color: "$background"
elements:
  - elementId: top-bar
    elementType: shape
    bounds: [0, 0, 1280, 6]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"
  - elementId: dir-badge-bg
    elementType: shape
    bounds: [60, 10, 80, 20]
    shapeName: roundRect
    adjustments: [8000]
    fill:
      type: solid
      color: "$primary"
  - elementId: dir-badge-text
    elementType: text
    bounds: [60, 10, 80, 20]
    content:
      fontSize: 12
      color: "#FFFFFF"
      fontFamily: "Inter, MiSans"
      align: [center, middle]
      wrap: false
      text: |
        Ch06
  - elementId: ev-badge-bg
    elementType: shape
    bounds: [1060, 10, 160, 20]
    shapeName: roundRect
    adjustments: [8000]
    fill:
      type: solid
      color: "$accent"
  - elementId: ev-badge-text
    elementType: text
    bounds: [1060, 10, 160, 20]
    content:
      fontSize: 12
      color: "#FFFFFF"
      fontFamily: "Inter, MiSans"
      align: [center, middle]
      wrap: false
      text: |
        E1 / Peer-reviewed
  - elementId: title
    elementType: text
    bounds: [60, 36, 990, 42]
    content:
      fontSize: 32
      color: "$primary"
      fontFamily: "Inter, MiSans"
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>VRASED: Verified RA Co-design — 实验与评价</strong></p>
  - elementId: title-line
    elementType: shape
    bounds: [60, 80, 120, 3]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"
  - elementId: exp-title
    elementType: text
    bounds: [60, 92, 200, 36]
    content:
      fontSize: 24
      color: "$primary"
      fontFamily: "Inter, MiSans"
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>实验结果</strong></p>
  - elementId: exp-body
    elementType: text
    bounds: [60, 128, 1160, 180]
    content:
      fontSize: 18
      color: "$text"
      fontFamily: "Inter, MiSans"
      lineHeight: 1.5
      align: [left, top]
      text: |
        <ul>
        <li>USENIX Security 2019 peer-reviewed paper，提供原型和验证证据。</li>
        <li>Reports prototype and verification evidence for simple embedded devices.</li>
        <li>只引用已核验的实验方向，不复制未复核的具体数值。</li>
        </ul>
  - elementId: eval-title
    elementType: text
    bounds: [60, 320, 200, 36]
    content:
      fontSize: 24
      color: "$primary"
      fontFamily: "Inter, MiSans"
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>文章评价</strong></p>
  - elementId: eval-table
    elementType: table
    bounds: [60, 356, 1160, 320]
    columnWidths: [0.15, 0.85]
    rowHeights: [0.12, 0.22, 0.22, 0.22, 0.22]
    style: "$default"
    rows:
      - - content:
            text: |
              <p><strong>维度</strong></p>
            align: [center, middle]
        - content:
            text: |
              <p><strong>判断</strong></p>
            align: [center, middle]
      - - content:
            text: |
              <p>设计优势</p>
            align: [center, middle]
        - content:
            text: |
              <p>证据强，结合形式化验证、硬件/软件 co-design 和真实原型。</p>
            align: [left, middle]
      - - content:
            text: |
              <p>主要局限</p>
            align: [center, middle]
        - content:
            text: |
              <p>目标是 simple embedded devices，不是 cloud CVM、CCA Realm 或 CoVE TVM evidence profile。</p>
            align: [left, middle]
      - - content:
            text: |
              <p>商业落地</p>
            align: [center, middle]
        - content:
            text: |
              <p>适合可审计 MCU/IoT RoT 和 attestation IP；风险在 proof maintenance、toolchain 和 profile 标准化。</p>
            align: [left, middle]
      - - content:
            text: |
              <p>讲稿定位</p>
            align: [center, middle]
        - content:
            text: |
              <p>当前 SOTA/补充边界；证据强度 E1</p>
            align: [left, middle]
  - elementId: source
    elementType: text
    bounds: [60, 690, 1160, 20]
    content:
      style: "$caption"
      align: [left, middle]
      wrap: false
      text: |
        来源：VRASED verified RA co-design｜证据等级：E1 / Peer-reviewed SOTA
  - elementId: bottom-bar
    elementType: shape
    bounds: [0, 714, 1280, 6]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"
