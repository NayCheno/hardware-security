pageType: content
background:
  type: solid
  color: "$background"
elements:
  - elementId: top-bar
    elementType: shape
    bounds: [0, 0, 1280, 6]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"
  - elementId: dir-badge-bg
    elementType: shape
    bounds: [60, 10, 80, 20]
    shapeName: roundRect
    adjustments: [8000]
    fill:
      type: solid
      color: "$primary"
  - elementId: dir-badge-text
    elementType: text
    bounds: [60, 10, 80, 20]
    content:
      fontSize: 12
      color: "#FFFFFF"
      fontFamily: "Inter, MiSans"
      align: [center, middle]
      wrap: false
      text: |
        Ch06
  - elementId: ev-badge-bg
    elementType: shape
    bounds: [1060, 10, 160, 20]
    shapeName: roundRect
    adjustments: [8000]
    fill:
      type: solid
      color: "$accent"
  - elementId: ev-badge-text
    elementType: text
    bounds: [1060, 10, 160, 20]
    content:
      fontSize: 12
      color: "#FFFFFF"
      fontFamily: "Inter, MiSans"
      align: [center, middle]
      wrap: false
      text: |
        E0 / Spec
  - elementId: title
    elementType: text
    bounds: [60, 36, 990, 42]
    content:
      fontSize: 32
      color: "$primary"
      fontFamily: "Inter, MiSans"
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>RATS 架构 — 实验与评价</strong></p>
  - elementId: title-line
    elementType: shape
    bounds: [60, 80, 120, 3]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"
  - elementId: exp-title
    elementType: text
    bounds: [60, 92, 200, 36]
    content:
      fontSize: 24
      color: "$primary"
      fontFamily: "Inter, MiSans"
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>实验结果</strong></p>
  - elementId: exp-body
    elementType: text
    bounds: [60, 128, 1160, 180]
    content:
      fontSize: 18
      color: "$text"
      fontFamily: "Inter, MiSans"
      lineHeight: 1.5
      align: [left, top]
      text: |
        <ul>
        <li>规范/Survey，无新实验。RATS 架构只支撑术语、taxonomy、接口语义或证据边界。</li>
        <li>不展示独立系统实验，也不把二手归纳写成一手结果。</li>
        <li>具体平台结论转到一手材料核验。</li>
        </ul>
  - elementId: eval-title
    elementType: text
    bounds: [60, 320, 200, 36]
    content:
      fontSize: 24
      color: "$primary"
      fontFamily: "Inter, MiSans"
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>文章评价</strong></p>
  - elementId: eval-table
    elementType: table
    bounds: [60, 356, 1160, 320]
    columnWidths: [0.15, 0.85]
    rowHeights: [0.12, 0.22, 0.22, 0.22, 0.22]
    style: "$default"
    rows:
      - - content:
            text: |
              <p><strong>维度</strong></p>
            align: [center, middle]
        - content:
            text: |
              <p><strong>判断</strong></p>
            align: [center, middle]
      - - content:
            text: |
              <p>设计优势</p>
            align: [center, middle]
        - content:
            text: |
              <p>是跨平台 attestation 术语和 verifier policy 的权威基线。</p>
            align: [left, middle]
      - - content:
            text: |
              <p>主要局限</p>
            align: [center, middle]
        - content:
            text: |
              <p>不证明任一平台测量链充分，也不定义完整 token claim encoding。</p>
            align: [left, middle]
      - - content:
            text: |
              <p>商业落地</p>
            align: [center, middle]
        - content:
            text: |
              <p>标准化落地潜力强；风险在平台 evidence profile、endorsement 分发和 verifier policy 运维复杂。</p>
            align: [left, middle]
      - - content:
            text: |
              <p>讲稿定位</p>
            align: [center, middle]
        - content:
            text: |
              <p>代表性改进；证据强度 E0</p>
            align: [left, middle]
  - elementId: source
    elementType: text
    bounds: [60, 690, 1160, 20]
    content:
      style: "$caption"
      align: [left, middle]
      wrap: false
      text: |
        来源：RATS 架构｜证据等级：E0 / Spec-standard SOTA
  - elementId: bottom-bar
    elementType: shape
    bounds: [0, 714, 1280, 6]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"
