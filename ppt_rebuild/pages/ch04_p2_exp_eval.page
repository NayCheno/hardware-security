pageType: content
background:
  type: solid
  color: "$background"
elements:
  - elementId: top-bar
    elementType: shape
    bounds: [0, 0, 1280, 6]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"
  - elementId: dir-badge-bg
    elementType: shape
    bounds: [60, 10, 80, 20]
    shapeName: roundRect
    adjustments: [8000]
    fill:
      type: solid
      color: "$primary"
  - elementId: dir-badge-text
    elementType: text
    bounds: [60, 10, 80, 20]
    content:
      fontSize: 12
      color: "#FFFFFF"
      fontFamily: "Inter, MiSans"
      align: [center, middle]
      wrap: false
      text: |
        Ch04
  - elementId: ev-badge-bg
    elementType: shape
    bounds: [1060, 10, 160, 20]
    shapeName: roundRect
    adjustments: [8000]
    fill:
      type: solid
      color: "$accent"
  - elementId: ev-badge-text
    elementType: text
    bounds: [1060, 10, 160, 20]
    content:
      fontSize: 12
      color: "#FFFFFF"
      fontFamily: "Inter, MiSans"
      align: [center, middle]
      wrap: false
      text: |
        E1 / Peer-reviewed
  - elementId: title
    elementType: text
    bounds: [60, 36, 990, 42]
    content:
      fontSize: 32
      color: "$primary"
      fontFamily: "Inter, MiSans"
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>RContainer: CCA 安全容器 — 实验与评价</strong></p>
  - elementId: title-line
    elementType: shape
    bounds: [60, 80, 120, 3]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"
  - elementId: exp-title
    elementType: text
    bounds: [60, 92, 200, 36]
    content:
      fontSize: 24
      color: "$primary"
      fontFamily: "Inter, MiSans"
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>实验结果</strong></p>
  - elementId: exp-body
    elementType: text
    bounds: [60, 128, 1160, 180]
    content:
      fontSize: 18
      color: "$text"
      fontFamily: "Inter, MiSans"
      lineHeight: 1.5
      align: [left, top]
      text: |
        <ul>
        <li>NDSS 系统论文提供原型评估。</li>
        <li>本报告不复制未核对的具体性能数字。</li>
        <li>实验关注容器启动、运行开销与 CCA lifecycle 耦合。</li>
        </ul>
  - elementId: eval-title
    elementType: text
    bounds: [60, 320, 200, 36]
    content:
      fontSize: 24
      color: "$primary"
      fontFamily: "Inter, MiSans"
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>文章评价</strong></p>
  - elementId: eval-table
    elementType: table
    bounds: [60, 356, 1160, 320]
    columnWidths: [0.15, 0.85]
    rowHeights: [0.12, 0.22, 0.22, 0.22, 0.22]
    style: "$default"
    rows:
      - - content:
            text: |
              <p><strong>维度</strong></p>
            align: [center, middle]
        - content:
            text: |
              <p><strong>判断</strong></p>
            align: [center, middle]
      - - content:
            text: |
              <p>设计优势</p>
            align: [center, middle]
        - content:
            text: |
              <p>贴近云原生落地，把 CCA 从 confidential VM 推向容器 workload。</p>
            align: [left, middle]
      - - content:
            text: |
              <p>主要局限</p>
            align: [center, middle]
        - content:
            text: |
              <p>容器生态、编排系统和 CCA lifecycle 的耦合复杂，生产部署需要额外工程证据。</p>
            align: [left, middle]
      - - content:
            text: |
              <p>商业落地</p>
            align: [center, middle]
        - content:
            text: |
              <p>商业潜力高，适合云平台安全容器服务；风险在 Kubernetes/runtime 改造、调试可观测性和租户迁移成本。</p>
            align: [left, middle]
      - - content:
            text: |
              <p>讲稿定位</p>
            align: [center, middle]
        - content:
            text: |
              <p>代表性改进；证据强度 E1</p>
            align: [left, middle]
  - elementId: source
    elementType: text
    bounds: [60, 690, 1160, 20]
    content:
      style: "$caption"
      align: [left, middle]
      wrap: false
      text: |
        来源：RContainer: CCA 安全容器｜证据等级：E1 / Peer-reviewed SOTA
  - elementId: bottom-bar
    elementType: shape
    bounds: [0, 714, 1280, 6]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"
