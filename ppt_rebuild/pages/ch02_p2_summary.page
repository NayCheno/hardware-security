pageType: content
background:
  type: solid
  color: "$background"
elements:
  - elementId: left-accent
    elementType: shape
    bounds: [60, 60, 4, 40]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"
  - elementId: title
    elementType: text
    bounds: [80, 55, 900, 40]
    content:
      fontSize: 28
      color: "$primary"
      fontFamily: "Inter, MiSans"
      wrap: false
      text: |
        <p><strong>Pinto 2019 — Demystifying Arm TrustZone</strong></p>
  - elementId: badge-bg
    elementType: shape
    bounds: [1060, 55, 160, 30]
    shapeName: roundRect
    adjustments: [10000]
    fill:
      type: solid
      color: "$accent"
  - elementId: badge-text
    elementType: text
    bounds: [1060, 55, 160, 30]
    content:
      fontSize: 12
      color: "#FFFFFF"
      fontFamily: "Inter, MiSans"
      align: [center, middle]
      wrap: false
      text: |
        <p>E2 / Background</p>
  - elementId: content
    elementType: text
    bounds: [80, 110, 1100, 480]
    content:
      fontSize: 18
      color: "$text"
      fontFamily: "Inter, MiSans"
      lineHeight: 1.5
      text: |
        <p><strong>核心贡献：</strong>全面梳理 TrustZone 架构、TEE 软件栈、应用和虚拟化相关工作，Systematic survey of TrustZone-assisted TEEs。</p>
        <p style="margin-top:12px"><strong>关键要点：</strong></p>
        <ul>
        <li>按系统软件、TEE、虚拟化和应用场景分类</li>
        <li>给 TrustZone 生态建立 survey map</li>
        <li>覆盖 TEE OS、trusted applications、硬件辅助虚拟化</li>
        <li>IoT 和 mobile deployment patterns 的系统分析</li>
        </ul>
  - elementId: source
    elementType: text
    bounds: [80, 660, 1100, 25]
    content:
      fontSize: 14
      color: "$secondary"
      fontFamily: "Inter, MiSans"
      wrap: false
      text: |
        <p>来源：Pinto 2019, DOI: 10.1145/3291047; local PDF 已核验</p>