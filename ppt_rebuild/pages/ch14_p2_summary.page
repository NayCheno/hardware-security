pageType: content
background:
  type: solid
  color: "$background"
elements:
  - elementId: top-bar
    elementType: shape
    bounds: [0, 0, 1280, 6]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"
  - elementId: dir-badge-bg
    elementType: shape
    bounds: [60, 30, 100, 24]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"
  - elementId: dir-badge-text
    elementType: text
    bounds: [60, 30, 100, 24]
    content:
      fontSize: 12
      color: "$white"
      align: [center, middle]
      wrap: false
      text: |
        <p>Accelerator / DPU...</p>
  - elementId: page-title
    elementType: text
    bounds: [60, 56, 1000, 40]
    content:
      style: "$title"
      fontSize: 32
      color: "$primary"
      align: [left, middle]
      wrap: false
      text: |
        <p>CloudScale Confidential Computing with Heterogeneous Devices — 内容摘要</p>
  - elementId: title-underline
    elementType: shape
    bounds: [60, 100, 120, 3]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"
  - elementId: evidence-badge-bg
    elementType: shape
    bounds: [1080, 30, 140, 24]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"
  - elementId: evidence-badge-text
    elementType: text
    bounds: [1080, 30, 140, 24]
    content:
      fontSize: 12
      color: "$white"
      align: [center, middle]
      wrap: false
      text: |
        <p>E1 / 同行评审改进证据</p>
  - elementId: body-content
    elementType: text
    bounds: [60, 120, 1160, 540]
    content:
      style: "$body"
      fontSize: 18
      color: "$text"
      lineHeight: 1.5
      align: [left, top]
      wrap: true
      text: |
        <p>CloudScale 用 cloud-scale Security Controller 桥接 TEE-enabled nodes 与 legacy non-TEE...</p>
        <p>Cloud-scale acceleration work is a peer-reviewed 2024 SOTA item for confidential...</p>
  - elementId: source-line
    elementType: text
    bounds: [60, 670, 1160, 30]
    content:
      style: "$caption"
      fontSize: 14
      color: "$secondary"
      align: [left, middle]
      wrap: false
      text: |
        <p>来源：CloudScale confidential computing with heterogeneous devices｜证据等级：E1 / Peer-reviewed SOTA</p>
  - elementId: bottom-bar
    elementType: shape
    bounds: [0, 714, 1280, 6]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"
