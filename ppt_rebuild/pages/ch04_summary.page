pageType: content
background:
  type: solid
  color: "$background"
elements:
  - elementId: top-bar
    elementType: shape
    bounds: [0, 0, 1280, 6]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"
  - elementId: dir-badge-bg
    elementType: shape
    bounds: [60, 10, 80, 20]
    shapeName: roundRect
    adjustments: [8000]
    fill:
      type: solid
      color: "$primary"
  - elementId: dir-badge-text
    elementType: text
    bounds: [60, 10, 80, 20]
    content:
      fontSize: 12
      color: "#FFFFFF"
      fontFamily: "Inter, MiSans"
      align: [center, middle]
      wrap: false
      text: |
        Ch04
  - elementId: title
    elementType: text
    bounds: [60, 36, 990, 42]
    content:
      fontSize: 32
      color: "$primary"
      fontFamily: "Inter, MiSans"
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>方向总结：Arm CCA 细粒度隔离与部署模型</strong></p>
  - elementId: title-line
    elementType: shape
    bounds: [60, 80, 120, 3]
    shapeName: rect
    fill:
      type: solid
      color: "$primary"
  - elementId: sum-table
    elementType: table
    bounds: [60, 100, 1160, 580]
    columnWidths: [0.22, 0.33, 0.33, 0.12]
    rowHeights: [0.12, 0.293, 0.293, 0.294]
    style: "$default"
    rows:
      - - content:
            text: |
              <p><strong>论文名</strong></p>
