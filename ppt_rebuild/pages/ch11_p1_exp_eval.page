pageType: content
background:
  type: solid
  color: "#FFFFFF"
elements:
- elementId: top-bar
  elementType: shape
  bounds: [0, 0, 1280, 6]
  shapeName: rect
  fill:
    type: solid
    color: $primary
- elementId: badge-bg
  elementType: shape
  bounds: [60, 14, 120, 22]
  shapeName: rect
  fill:
    type: solid
    color: $primary
- elementId: badge-text
  elementType: text
  bounds: [60, 14, 120, 22]
  content:
    fontSize: 12
    color: #FFFFFF
    fontFamily: Inter, MiSans
    lineHeight: 1.0
    align: [center, middle]
    wrap: False
    text: |
      CH11
- elementId: exp-title
  elementType: text
  bounds: [60, 40, 300, 35]
  content:
    fontSize: 24
    color: $primary
    fontFamily: Inter, MiSans
    lineHeight: 1.5
    wrap: True
    text: |
      <p><strong>实验结果</strong></p>
- elementId: exp-body
  elementType: text
  bounds: [60, 80, 1160, 230]
  content:
    fontSize: 18
    color: $text
    fontFamily: Inter, MiSans
    lineHeight: 1.5
    wrap: True
    text: |
      <ul>
      <li>规范/Survey，无新实验。</li>
      <li>本页不展示独立系统实验，也不把二手归纳写成一手结果。</li>
      <li>涉及具体平台、协议状态或数值时，转到原始论文、官方规范或厂商材料核验。</li>
      </ul>
- elementId: eval-title
  elementType: text
  bounds: [60, 330, 300, 35]
  content:
    fontSize: 24
    color: $primary
    fontFamily: Inter, MiSans
    lineHeight: 1.5
    wrap: True
    text: |
      <p><strong>文章评价</strong></p>
- elementId: eval-table
  elementType: table
  bounds: [60, 370, 1160, 280]
  columnWidths: [0.2000, 0.8000]
  rowHeights: [0.2000, 0.2000, 0.2000, 0.2000, 0.2000]
  style: $default
  rows:
    -
      - content: {text: "维度"}
      - content: {text: "判断"}
    -
      - content: {text: "设计优势"}
      - content: {text: "最适合给本方向提供概念边界，防止把 PMP/GPT/IOPMP 写成 encryption。"}
    -
      - content: {text: "主要局限"}
      - content: {text: "2014 时间截面早于 SEV-SNP、TDX、Arm CCA、RISC-V CoVE 和 CXL/PCIe IDE。"}
    -
      - content: {text: "商业落地"}
      - content: {text: "可作为架构设计 checklist；风险是单独引用会遗漏现代 confidential VM ownership metadata。"}
    -
      - content: {text: "讲稿定位"}
      - content: {text: "开创/基础入口；证据强度 E2"}
- elementId: source
  elementType: text
  bounds: [60, 690, 1160, 20]
  content:
    fontSize: 14
    color: $secondary
    fontFamily: Inter, MiSans
    lineHeight: 1.2
    wrap: True
    text: |
      来源：Memory Encryption: A Survey of Existing Techniques｜证据等级：E2 / Background substrate
- elementId: bottom-bar
  elementType: shape
  bounds: [0, 714, 1280, 6]
  shapeName: rect
  fill:
    type: solid
    color: $primary
